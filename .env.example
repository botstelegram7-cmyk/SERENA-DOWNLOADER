# Application
APP_NAME=SERENA
HOST=0.0.0.0
# Render supplies PORT automatically. 10000 is convenient for local Docker.
PORT=10000
DOWNLOAD_DIR=downloads
UPDATES_CHANNEL_URL=https://t.me/serenaunzipbot

# Telegram MTProto credentials - https://my.telegram.org/auth?to=apps
API_ID=123456
API_HASH=replace_with_telegram_api_hash

# Telegram bot token - https://t.me/BotFather
BOT_TOKEN=123456789:replace_with_botfather_token

# SERENA media API
# API docs: https://portal.arcmusic.fun/docs
# Register: https://portal.arcmusic.fun/register
# Plans: https://portal.arcmusic.fun/plans
# API key page: https://portal.arcmusic.fun/usage
# Keep the URL that provides the endpoints used by this bot.
API_URL=https://api.arcmusic.fun
# Use either API_KEY for one key, or API_KEYS for multiple fallback keys.
# When API_KEYS is set, it takes priority over API_KEY.
API_KEY=
API_KEYS=replace_with_key_1,replace_with_key_2

# MongoDB. For docker compose use mongodb://mongo:27017/serena.
# For Render use a MongoDB Atlas mongodb+srv:// connection string.
MONGO_URI=mongodb://mongo:27017/serena
MONGO_DB=serena

# Telegram numeric user IDs. OWNER_ID is also added to SUDO_USERS automatically.
OWNER_ID=123456789
SUDO_USERS=123456789
